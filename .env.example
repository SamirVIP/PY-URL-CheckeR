# Copy this file to ".env" and fill in your own values.

# Token from @BotFather
BOT_TOKEN=8593278400:AAGkwwoRzvAz9Y3Zcan_JtLKxyeNEm8gS_M

# Chats allowed to use the bot, comma separated.
#   - your own chat: your user ID (message @userinfobot to see it)
#   - a GROUP: its ID, a negative number like -1001234567890
#     (add the bot to the group and send /id there to see the group's ID)
ALLOWED_CHAT_IDS=6206433961

# Optional: extra people allowed to use /allow and /disallow
# (by default every personal ID listed in ALLOWED_CHAT_IDS is an admin).
# ADMIN_IDS=

# ---------------- Speed / limits (all optional) ----------------
# Highest number of link x word combinations in ONE run.
MAX_COMBINATIONS=600000

# Total simultaneous requests, shared by all worker processes.
# Higher = faster, but if the server starts blocking you, lower it.
CONCURRENCY=600

# Worker processes. 0 = automatic (one per CPU core, max 4).
PROCESSES=0

# Seconds before a request is considered failed (it is then retried).
CONNECT_TIMEOUT=8
TOTAL_TIMEOUT=15
# Tries per link before it is put aside for the final re-check rounds.
ATTEMPTS=3
