# Copy this file to ".env" and fill in your own values.
# On Railway: don't upload .env - add these same names in the service's "Variables" tab instead.

# Token from @BotFather
BOT_TOKEN=8593278400:AAElT74GD-LRaACB7p5QrKI-hIDP_5ocuT8

# ---------------- Who is the admin? ----------------
# ALLOWED_CHAT_IDS holds:
#   - your own Telegram user ID (positive number)  -> you are an ADMIN (find it with @userinfobot)
#   - group IDs (negative numbers like -1001234567890) -> groups allowed to use the bot
# IMPORTANT: open the bot once and press Start, so it can send you access requests.
ALLOWED_CHAT_IDS=6206433961

# Optional: extra admins (user IDs, comma separated).
# ADMIN_IDS=

# ---------------- Limits and speed (all optional) ----------------
# Highest number of link x word combinations in ONE run (10,000,000 = 10 million).
MAX_COMBINATIONS=10000000

# MAXIMUM simultaneous requests, shared by all worker processes. The bot lowers this
# automatically when the server pushes back (HTTP 429 / errors) and raises it again when
# the server is happy, so a high value is safe.
CONCURRENCY=1000

# Worker processes. 0 = automatic (one per CPU core, max 4).
PROCESSES=0

# Seconds before a request is considered failed (it is then retried).
CONNECT_TIMEOUT=8
TOTAL_TIMEOUT=15
# Tries per link before it is put aside for the final re-check rounds.
ATTEMPTS=3

# Most "working link" messages one run may send (the results file always has ALL of them).
# A safety net so a misbehaving server can never flood a chat. 0 = unlimited.
MAX_ALERTS_PER_RUN=500

# Largest picture (in MB) the bot will download to send with a link.
MAX_IMAGE_MB=20

# Where users, permissions and history are saved. On Railway: attach a Volume mounted at /data
# (the bot detects it automatically) - otherwise everything is lost on every deploy.
# DATA_DIR=/data
